        },
        "last_run_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Run At"
        },
        "ns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
