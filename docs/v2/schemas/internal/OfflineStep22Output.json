{
  "$defs": {
    "CycleReport": {
      "additionalProperties": true,
      "description": "draft: pending schema session 8.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/DerivationBudget"
        },
        "deferred_total": {
          "default": 0,
          "title": "Deferred Total",
          "type": "integer"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "freshness": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Freshness",
          "type": "object"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "job_kind": {
          "enum": [
            "full",
            "reconcile_only",
            "rederive"
          ],
          "title": "Job Kind",
          "type": "string"
        },
        "manual": {
          "default": false,
          "title": "Manual",
          "type": "boolean"
        },
        "ns": {
          "title": "Ns",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageReport"
          },
          "title": "Stages",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "ns",
        "job_kind",
        "started_at",
        "ended_at"
      ],
      "title": "CycleReport",
      "type": "object"
    },
    "DerivationBudget": {
      "additionalProperties": true,
      "description": "draft: field layout pending schema session 9 (overload and accounting).",
      "properties": {
        "by_class": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Class",
          "type": "object"
        },
        "spent": {
          "default": 0,
          "title": "Spent",
          "type": "integer"
        },
        "tokens_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Total"
        }
      },
      "title": "DerivationBudget",
      "type": "object"
    },
    "NamespaceTriggerState": {
      "additionalProperties": true,
      "description": "draft: pending schema session 8.",
      "properties": {
        "deferred_units": {
          "default": 0,
          "title": "Deferred Units",
          "type": "integer"
        },
        "deposits_since_run": {
          "title": "Deposits Since Run",
          "type": "integer"
        },
        "last_deposit_at": {
          "format": "date-time",
          "title": "Last Deposit At",
          "type": "string"
        },
        "last_reconcile_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Reconcile At"
        },
        "last_run_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Run At"
        },
        "ns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ns"
        }
      },
      "required": [
        "deposits_since_run",
        "last_deposit_at"
      ],
      "title": "NamespaceTriggerState",
      "type": "object"
    },
    "OutboxRow": {
      "additionalProperties": true,
      "description": "draft: field layout pending schema session 8 (jobs and progress).\n\nInsert and offline specs differ (kinds, ``scope`` vs ``namespace``, ``source_ids`` vs ``members``); both\nspellings are accepted until session 8.",
      "properties": {
        "attempts": {
          "default": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "epoch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epoch"
        },
        "failure_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Class"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "generation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "projection",
            "derivation",
            "session_close",
            "sleep_stage",
            "rederive",
            "pending_merge",
            "asset",
            "window",
            "heavy_projection"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "lease_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Owner"
        },
        "lease_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Until"
        },
        "members": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Members",
          "type": "array"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        },
        "not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Before"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_ids": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "leased",
            "done",
            "failed",
            "dead",
            "underived"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "OutboxRow",
      "type": "object"
    },
