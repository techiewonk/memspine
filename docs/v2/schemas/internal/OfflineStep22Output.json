{
  "$defs": {
    "CycleReport": {
      "additionalProperties": true,
      "description": "Internal step type.",
      "properties": {
        "budget": {
          "$ref": "#/$defs/DerivationBudget"
        },
        "deferred_total": {
          "default": 0,
          "title": "Deferred Total",
          "type": "integer"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "freshness": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Freshness",
          "type": "object"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "job_kind": {
          "enum": [
            "full",
            "reconcile_only",
            "rederive"
          ],
          "title": "Job Kind",
          "type": "string"
        },
        "manual": {
          "default": false,
          "title": "Manual",
          "type": "boolean"
        },
        "ns": {
          "title": "Ns",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageReport"
          },
          "title": "Stages",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "ns",
        "job_kind",
        "started_at",
        "ended_at"
      ],
      "title": "CycleReport",
      "type": "object"
    },
    "DerivationBudget": {
      "additionalProperties": true,
      "description": "Internal step type.",
      "properties": {
        "by_class": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Class",
          "type": "object"
        },
        "spent": {
          "default": 0,
          "title": "Spent",
          "type": "integer"
        },
        "tokens_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Total"
        }
      },
      "title": "DerivationBudget",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": true,
      "description": "Derivation fingerprint (P-12): what produced a derived item, for staleness and re-derivation.",
      "properties": {
        "decoding": {
          "title": "Decoding",
          "type": "string"
        },
        "input_blocks": {
          "title": "Input Blocks",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "quant": {
          "title": "Quant",
          "type": "string"
        },
        "runtime_libs": {
          "title": "Runtime Libs",
          "type": "string"
        },
        "schema_v": {
          "title": "Schema V",
          "type": "string"
        }
      },
      "required": [
        "prompt_hash",
        "schema_v",
        "model_id",
        "quant",
        "decoding",
        "input_blocks",
        "runtime_libs"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "NamespaceTriggerState": {
      "additionalProperties": true,
      "description": "Internal step type.",
      "properties": {
        "deferred_units": {
          "default": 0,
          "title": "Deferred Units",
          "type": "integer"
        },
        "deposits_since_run": {
          "title": "Deposits Since Run",
          "type": "integer"
        },
        "last_deposit_at": {
          "format": "date-time",
          "title": "Last Deposit At",
          "type": "string"
        },
        "last_reconcile_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Reconcile At"
        },
        "last_run_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Run At"
        },
        "ns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ns"
        }
      },
      "required": [
        "deposits_since_run",
        "last_deposit_at"
      ],
      "title": "NamespaceTriggerState",
      "type": "object"
    },
    "OutboxRow": {
      "additionalProperties": true,
      "description": "One unit of derived work, claimed under a lease. The insert and offline spellings are unified.\n\n``sources`` replaces insert's ``source_id``+``source_version`` and offline's ``source_ids``/``members``;\n``scope`` replaces offline's ``namespace``. ``erasure_generation`` is the generation at enqueue (G-13).\n``epoch`` is the claim epoch of the current lease (ER-07); a commit is refused if it is stale.",
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "epoch": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epoch"
        },
        "erasure_generation": {
          "default": 0,
          "minimum": 0,
          "title": "Erasure Generation",
          "type": "integer"
        },
        "failure_class": {
          "anyOf": [
            {
              "enum": [
                "raised",
                "malformed",
                "valid_empty",
                "truncated",
                "size_skip",
                "partial_commit",
                "invented_alias",
                "budget_exhausted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Class"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "projection",
            "derivation",
            "session_close",
            "sleep_stage",
            "rederive",
            "pending_merge",
            "asset",
            "window",
            "heavy_projection"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "lease_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Owner"
        },
        "lease_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Until"
        },
        "not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Before"
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/OwnerScope"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "leased",
            "done",
            "failed",
            "dead",
            "underived"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "kind"
      ],
      "title": "OutboxRow",
      "type": "object"
    },
    "OwnerScope": {
      "additionalProperties": true,
      "description": "Memory scope: tenant plus memory owner (S3-1).\n\nThe owner is a user or a shared group; every agent and session serving that owner sees the same\nentities. The session is *not* part of the scope: it is recorded as :class:`Provenance` only.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_kind": {
          "default": "user",
          "enum": [
            "user",
            "group"
          ],
          "title": "Owner Kind",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "owner"
      ],
      "title": "OwnerScope",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "A pinned source: id plus version.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "StageReport": {
      "additionalProperties": true,
      "description": "Internal step type.",
      "properties": {
        "calls": {
          "default": 0,
          "title": "Calls",
          "type": "integer"
        },
        "deferred": {
          "default": 0,
          "title": "Deferred",
          "type": "integer"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "guard_rejections": {
          "default": 0,
          "title": "Guard Rejections",
          "type": "integer"
        },
        "p50_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P50 Ms"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P95 Ms"
        },
        "produced": {
          "default": 0,
          "title": "Produced",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "skipped",
            "error",
            "noop"
          ],
          "title": "Status",
          "type": "string"
        },
        "tokens_cached": {
          "default": 0,
          "title": "Tokens Cached",
          "type": "integer"
        },
        "tokens_in": {
          "default": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "watermark_from": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Watermark From"
        },
        "watermark_to": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Watermark To"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "StageReport",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "released_rows": {
      "items": {
        "$ref": "#/$defs/OutboxRow"
      },
      "title": "Released Rows",
      "type": "array"
    },
    "report": {
      "$ref": "#/$defs/CycleReport"
    },
    "trigger_state": {
      "$ref": "#/$defs/NamespaceTriggerState"
    }
  },
  "required": [
    "report",
    "trigger_state"
  ],
  "title": "OfflineStep22Output",
  "type": "object"
}
