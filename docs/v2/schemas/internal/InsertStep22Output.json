{
  "$defs": {
    "AssertionEnvelope": {
      "additionalProperties": true,
      "description": "One stored assertion.\n\nIdentities are separate fields (ER-13, S3): ``write_id`` (retry id of the write that produced it),\nmention ids (on :class:`Mention`), ``assertion_key``, ``occurrence_id`` and ``record_id`` (``None``\nonly until the write door assigns it). ``scope`` is tenant plus owner; the session is provenance.",
      "properties": {
        "assertion_key": {
          "$ref": "#/$defs/AssertionKey"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "checks": {
          "anyOf": [
            {
              "$ref": "#/$defs/GroundingChecks"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "epoch": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epoch"
        },
        "erasure_generation": {
          "default": 0,
          "minimum": 0,
          "title": "Erasure Generation",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "extras": {
          "additionalProperties": true,
          "title": "Extras",
          "type": "object"
        },
        "graph": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph"
        },
        "grounding": {
          "anyOf": [
            {
              "enum": [
                "grounded",
                "uncertain",
                "rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grounding"
        },
        "key_aliases": {
          "items": {
            "type": "string"
          },
          "title": "Key Aliases",
          "type": "array"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mention"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurrence_id": {
          "minLength": 1,
          "title": "Occurrence Id",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/OwnerScope"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "src_class": {
          "enum": [
            "user_stated",
            "assistant_proposed",
            "user_confirmed",
            "tool",
            "document",
            "external",
            "derived"
          ],
          "title": "Src Class",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "tentative",
            "contested",
            "superseded",
            "hidden"
          ],
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mention"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/TimeAxes"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationVerdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "write_id": {
          "minLength": 1,
          "title": "Write Id",
          "type": "string"
        }
      },
      "required": [
        "write_id",
        "assertion_key",
        "occurrence_id",
        "scope",
        "text",
        "kind",
        "assessment",
        "src_class"
      ],
      "title": "AssertionEnvelope",
      "type": "object"
    },
    "AssertionKey": {
      "additionalProperties": true,
      "description": "What an assertion is about: ``(src, rel, dst, kind)`` under the envelope's owner scope (M-17).\n\n``key_v`` versions the normalisation rules. The scope lives on the envelope, not here.",
      "properties": {
        "dst": {
          "default": "",
          "title": "Dst",
          "type": "string"
        },
        "key_v": {
          "default": 1,
          "minimum": 1,
          "title": "Key V",
          "type": "integer"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "rel": {
          "minLength": 1,
          "title": "Rel",
          "type": "string"
        },
        "src": {
          "minLength": 1,
          "title": "Src",
          "type": "string"
        }
      },
      "required": [
        "src",
        "rel",
        "kind"
      ],
      "title": "AssertionKey",
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": true,
      "description": "What the system knows about how far an assertion can be believed (ER-14), as separate fields.\n\n``model_confidence_hint`` is the model's self-confidence, a hint only (S2-1): it feeds nothing in\nsupersede, graph or profile logic.",
      "properties": {
        "binding": {
          "enum": [
            "bound",
            "partly",
            "unbound"
          ],
          "title": "Binding",
          "type": "string"
        },
        "modality": {
          "enum": [
            "asserted",
            "negated",
            "hypothetical",
            "planned",
            "reported",
            "question"
          ],
          "title": "Modality",
          "type": "string"
        },
        "model_confidence_hint": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Confidence Hint"
        },
        "source_trust": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Trust",
          "type": "number"
        },
        "support": {
          "$ref": "#/$defs/Support"
        },
        "time_precision": {
          "default": "unknown",
          "enum": [
            "instant",
            "minute",
            "hour",
            "day",
            "week",
            "month",
            "season",
            "year",
            "decade",
            "unknown"
          ],
          "title": "Time Precision",
          "type": "string"
        }
      },
      "required": [
        "source_trust",
        "binding",
        "modality"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Duration": {
      "additionalProperties": true,
      "description": "A length of time: value plus unit, with an anchor when one is known (S6-4).",
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        },
        "unit": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day",
            "week",
            "month",
            "year"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Duration",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": true,
      "description": "One piece of evidence for an assertion.\n\n* ``support`` states the fact.\n* ``binding`` resolves a pronoun, relative date or reference (ER-11); it must be cited.\n* ``context`` is shown to the model but never counts as evidence and never raises trust.\n\n``source_family`` is the asserting principal (S4-2): speaker id, author or document, tool name, or a\nweb page's registrable domain. Derived records inherit parents' families through lineage.",
      "properties": {
        "role": {
          "enum": [
            "support",
            "binding",
            "context"
          ],
          "title": "Role",
          "type": "string"
        },
        "source_family": {
          "minLength": 1,
          "title": "Source Family",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "role",
        "source_family"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": true,
      "description": "Derivation fingerprint (P-12): what produced a derived item, for staleness and re-derivation.",
      "properties": {
        "decoding": {
          "title": "Decoding",
          "type": "string"
        },
        "input_blocks": {
          "title": "Input Blocks",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "quant": {
          "title": "Quant",
          "type": "string"
        },
        "runtime_libs": {
          "title": "Runtime Libs",
          "type": "string"
        },
        "schema_v": {
          "title": "Schema V",
          "type": "string"
        }
      },
      "required": [
        "prompt_hash",
        "schema_v",
        "model_id",
        "quant",
        "decoding",
        "input_blocks",
        "runtime_libs"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "GroundingChecks": {
      "additionalProperties": true,
      "description": "Per-check grounding results (W-17); ``None`` = check not run.",
      "properties": {
        "endpoints": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoints"
        },
        "names": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Names"
        },
        "numbers": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numbers"
        },
        "polarity": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polarity"
        },
        "span": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span"
        }
      },
      "title": "GroundingChecks",
      "type": "object"
    },
    "IntegrationVerdict": {
      "additionalProperties": true,
      "description": "How the conflict ladder integrated this assertion (G0 operator split), set at integration.",
      "properties": {
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "op": {
          "enum": [
            "append",
            "supersede",
            "merge",
            "coexist",
            "contest",
            "noop",
            "defer_kc"
          ],
          "title": "Op",
          "type": "string"
        },
        "rung": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rung"
        }
      },
      "required": [
        "op"
      ],
      "title": "IntegrationVerdict",
      "type": "object"
    },
    "IntentStatus": {
      "additionalProperties": true,
      "description": "Internal step type.",
      "properties": {
        "covers_seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covers Seq"
        },
        "failure_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Class"
        },
        "intent_id": {
          "title": "Intent Id",
          "type": "string"
        },
        "layers": {
          "additionalProperties": {
            "enum": [
              "pending",
              "leased",
              "done",
              "failed",
              "underived",
              "skipped"
            ],
            "type": "string"
          },
          "title": "Layers",
          "type": "object"
        }
      },
      "required": [
        "intent_id",
        "layers"
      ],
      "title": "IntentStatus",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": true,
      "description": "When something was true or happened. Either end may be open or unresolved; not both absent.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Interval",
      "type": "object"
    },
    "LineageEdge": {
      "additionalProperties": true,
      "description": "One edge of the lineage DAG. A derived record inherits families and trust bounds through these.",
      "properties": {
        "child": {
          "minLength": 1,
          "title": "Child",
          "type": "string"
        },
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent": {
          "minLength": 1,
          "title": "Parent",
          "type": "string"
        },
        "parent_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Version"
        },
        "role": {
          "enum": [
            "support",
            "binding",
            "context",
            "version_of",
            "supersedes",
            "merge_member",
            "member",
            "cites"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Family"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "child",
        "parent",
        "role"
      ],
      "title": "LineageEdge",
      "type": "object"
    },
    "MemoryEvent": {
      "additionalProperties": true,
      "description": "One immutable entry in the ``memory_events`` log.\n\n``seq`` is assigned by the write door at append time (monotonic per store); ``None`` only before.\nThe instance field ``kind`` is the *event* kind; the durable kind id of this model is ``memory_event``.",
      "properties": {
        "actor": {
          "default": "system",
          "title": "Actor",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/OwnerScope"
        },
        "seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seq"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "kind",
        "scope",
        "ts"
      ],
      "title": "MemoryEvent",
      "type": "object"
    },
    "Mention": {
      "additionalProperties": true,
      "description": "A surface mention as written, with its system-assigned mention id and resolved entity (if any).",
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "mention_id": {
          "minLength": 1,
          "title": "Mention Id",
          "type": "string"
        },
        "surface": {
          "minLength": 1,
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "surface",
        "mention_id"
      ],
      "title": "Mention",
      "type": "object"
    },
    "OutboxRow": {
      "additionalProperties": true,
      "description": "One unit of derived work, claimed under a lease. The insert and offline spellings are unified.\n\n``sources`` replaces insert's ``source_id``+``source_version`` and offline's ``source_ids``/``members``;\n``scope`` replaces offline's ``namespace``. ``erasure_generation`` is the generation at enqueue (G-13).\n``epoch`` is the claim epoch of the current lease (ER-07); a commit is refused if it is stale.",
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "epoch": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epoch"
        },
        "erasure_generation": {
          "default": 0,
          "minimum": 0,
          "title": "Erasure Generation",
          "type": "integer"
        },
        "failure_class": {
          "anyOf": [
            {
              "enum": [
                "raised",
                "malformed",
                "valid_empty",
                "truncated",
                "size_skip",
                "partial_commit",
                "invented_alias",
                "budget_exhausted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Class"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "projection",
            "derivation",
            "session_close",
            "sleep_stage",
            "rederive",
            "pending_merge",
            "asset",
            "window",
            "heavy_projection"
          ],
          "title": "Kind",
          "type": "string"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "lease_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Owner"
        },
        "lease_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Until"
        },
        "not_before": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
