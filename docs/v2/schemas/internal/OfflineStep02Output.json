{
  "$defs": {
    "DerivationBudget": {
      "additionalProperties": true,
      "description": "Internal step type.",
      "properties": {
        "by_class": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Class",
          "type": "object"
        },
        "spent": {
          "default": 0,
          "title": "Spent",
          "type": "integer"
        },
        "tokens_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Total"
        }
      },
      "title": "DerivationBudget",
      "type": "object"
    },
    "DirtySet": {
      "additionalProperties": true,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/MemoryEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "neighbours": {
          "items": {
            "type": "string"
          },
          "title": "Neighbours",
          "type": "array"
        }
      },
      "title": "DirtySet",
      "type": "object"
    },
    "Hole": {
      "additionalProperties": true,
      "description": "An offset that the watermark passed without a successful result (ER-09).",
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "raised",
            "malformed",
            "valid_empty",
            "truncated",
            "size_skip",
            "partial_commit",
            "invented_alias",
            "budget_exhausted"
          ],
          "title": "Reason",
          "type": "string"
        },
        "waived": {
          "default": false,
          "title": "Waived",
          "type": "boolean"
        }
      },
      "required": [
        "offset",
        "reason"
      ],
      "title": "Hole",
      "type": "object"
    },
    "JobLease": {
      "additionalProperties": true,
      "description": "A claim on a job or namespace. ``epoch`` strictly increases per (scope, job) with each claim.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "heartbeat_at": {
          "format": "date-time",
          "title": "Heartbeat At",
          "type": "string"
        },
        "job_id": {
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "lease_until": {
          "format": "date-time",
          "title": "Lease Until",
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/OwnerScope"
        }
      },
      "required": [
        "scope",
        "job_id",
        "owner",
        "epoch",
        "acquired_at",
        "heartbeat_at",
        "lease_until"
      ],
      "title": "JobLease",
      "type": "object"
    },
    "MemoryEvent": {
      "additionalProperties": true,
      "description": "One immutable entry in the ``memory_events`` log.\n\n``seq`` is assigned by the write door at append time (monotonic per store); ``None`` only before.\nThe instance field ``kind`` is the *event* kind; the durable kind id of this model is ``memory_event``.",
      "properties": {
        "actor": {
          "default": "system",
          "title": "Actor",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/OwnerScope"
        },
        "seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seq"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "kind",
        "scope",
        "ts"
      ],
      "title": "MemoryEvent",
      "type": "object"
    },
    "OwnerScope": {
      "additionalProperties": true,
      "description": "Memory scope: tenant plus memory owner (S3-1).\n\nThe owner is a user or a shared group; every agent and session serving that owner sees the same\nentities. The session is *not* part of the scope: it is recorded as :class:`Provenance` only.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_kind": {
          "default": "user",
          "enum": [
            "user",
            "group"
          ],
          "title": "Owner Kind",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "owner"
      ],
      "title": "OwnerScope",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": true,
      "description": "Contiguous watermark plus an explicit list of holes.\n\nEvery offset up to and including ``watermark`` was handled; the ``holes`` among them were not\nsuccessfully derived and stay listed until filled (the hole is removed) or waived.",
      "properties": {
        "holes": {
          "items": {
            "$ref": "#/$defs/Hole"
          },
          "title": "Holes",
          "type": "array"
        },
        "job_kind": {
          "minLength": 1,
          "title": "Job Kind",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/OwnerScope"
        },
        "target_offset": {
          "anyOf": [
            {
              "minimum": -1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Offset"
        },
        "watermark": {
          "minimum": -1,
          "title": "Watermark",
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "job_kind",
        "watermark"
      ],
      "title": "Progress",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": true,
      "description": "Where a write came from. Provenance only: never part of identity or entity keys (S3-1).",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "principal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Principal"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "budget": {
      "$ref": "#/$defs/DerivationBudget"
    },
    "dirty": {
      "additionalProperties": {
        "$ref": "#/$defs/DirtySet"
      },
      "title": "Dirty",
      "type": "object"
    },
    "lease": {
      "$ref": "#/$defs/JobLease"
    },
    "watermarks": {
      "items": {
        "$ref": "#/$defs/Progress"
      },
      "title": "Watermarks",
      "type": "array"
    }
  },
  "required": [
    "lease"
  ],
  "title": "OfflineStep02Output",
  "type": "object"
}
