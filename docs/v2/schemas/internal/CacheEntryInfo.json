{
  "$defs": {
    "CacheKey": {
      "additionalProperties": true,
      "description": "A cache entry is keyed on all of these (ER-31); caches stay off until the ER-31 tests pass.\n\nThe query is normalised on validation and ``model_ids`` is sorted and de-duplicated, so equivalent\ninputs give the same key.",
      "properties": {
        "config_hash": {
          "minLength": 1,
          "title": "Config Hash",
          "type": "string"
        },
        "erasure_generation": {
          "minimum": 0,
          "title": "Erasure Generation",
          "type": "integer"
        },
        "model_ids": {
          "items": {
            "type": "string"
          },
          "title": "Model Ids",
          "type": "array"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/OwnerScope"
        },
        "store_generation": {
          "minimum": 0,
          "title": "Store Generation",
          "type": "integer"
        },
        "viewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viewer"
        }
      },
      "required": [
        "scope",
        "query",
        "config_hash",
        "store_generation",
        "erasure_generation"
      ],
      "title": "CacheKey",
      "type": "object"
    },
    "OwnerScope": {
      "additionalProperties": true,
      "description": "Memory scope: tenant plus memory owner (S3-1).\n\nThe owner is a user or a shared group; every agent and session serving that owner sees the same\nentities. The session is *not* part of the scope: it is recorded as :class:`Provenance` only.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_kind": {
          "default": "user",
          "enum": [
            "user",
            "group"
          ],
          "title": "Owner Kind",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "owner"
      ],
      "title": "OwnerScope",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Step 20 cache description.(CacheKey).",
  "properties": {
    "cache": {
      "title": "Cache",
      "type": "string"
    },
    "hit": {
      "title": "Hit",
      "type": "boolean"
    },
    "key": {
      "anyOf": [
        {
          "$ref": "#/$defs/CacheKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "cache",
    "hit"
  ],
  "title": "CacheEntryInfo",
  "type": "object"
}
