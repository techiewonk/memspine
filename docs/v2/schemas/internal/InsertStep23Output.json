{
  "$defs": {
    "IntentStatus": {
      "additionalProperties": true,
      "description": "Internal step type.",
      "properties": {
        "covers_seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covers Seq"
        },
        "failure_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Class"
        },
        "intent_id": {
          "title": "Intent Id",
          "type": "string"
        },
        "layers": {
          "additionalProperties": {
            "enum": [
              "pending",
              "leased",
              "done",
              "failed",
              "underived",
              "skipped"
            ],
            "type": "string"
          },
          "title": "Layers",
          "type": "object"
        }
      },
      "required": [
        "intent_id",
        "layers"
      ],
      "title": "IntentStatus",
      "type": "object"
    },
    "LedgerEntry": {
      "additionalProperties": true,
      "description": "Internal step type.",
      "properties": {
        "cache_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache State"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "cost_estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Estimate"
        },
        "items_grounded": {
          "default": 0,
          "title": "Items Grounded",
          "type": "integer"
        },
        "items_rejected": {
          "default": 0,
          "title": "Items Rejected",
          "type": "integer"
        },
        "items_uncertain": {
          "default": 0,
          "title": "Items Uncertain",
          "type": "integer"
        },
        "layer": {
          "anyOf": [
            {
              "enum": [
                "L0",
                "L1",
                "L2",
                "L3",
                "L4",
                "L5"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "queue_delay_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Delay Ms"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "worker",
                "reader"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "tokenizer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer"
        },
        "tokens_in": {
          "default": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "title": "Tokens Out",
          "type": "integer"
        }
      },
      "required": [
        "call_id"
      ],
      "title": "LedgerEntry",
      "type": "object"
    },
    "Readiness": {
      "additionalProperties": true,
      "description": "State of each capability for a write. A capability that is not configured is ``unavailable``,\nnever ``pending`` (S7).",
      "properties": {
        "facts": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Facts",
          "type": "string"
        },
        "graph": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Graph",
          "type": "string"
        },
        "profile": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Profile",
          "type": "string"
        },
        "raw_search": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Raw Search",
          "type": "string"
        },
        "summaries": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Summaries",
          "type": "string"
        }
      },
      "required": [
        "raw_search",
        "facts",
        "graph",
        "summaries",
        "profile"
      ],
      "title": "Readiness",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": true,
      "description": "Handle-side scope as read by the retrieve steps (tenant, user, agent, session, principal).\n\nDurable records use :class:`memspine.schemas.durable.OwnerScope` (tenant plus owner, S3-1); this is the\ncaller-facing handle shape the read path resolves into one.",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent"
        },
        "principal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Principal"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "session": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session"
        },
        "tenant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "viewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viewer"
        }
      },
      "title": "Scope",
      "type": "object"
    },
    "WaitResult": {
      "additionalProperties": true,
      "description": "Readiness reached by ``wait(capabilities, timeout)``. A read issued after a timed-out wait is\nmarked partial with the missing capabilities listed.",
      "properties": {
        "readiness": {
          "$ref": "#/$defs/Readiness"
        },
        "requested": {
          "items": {
            "enum": [
              "raw_search",
              "facts",
              "graph",
              "summaries",
              "profile"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested",
          "type": "array"
        },
        "timed_out": {
          "title": "Timed Out",
          "type": "boolean"
        },
        "waited_ms": {
          "minimum": 0,
          "title": "Waited Ms",
          "type": "integer"
        }
      },
      "required": [
        "requested",
        "readiness",
        "timed_out",
        "waited_ms"
      ],
      "title": "WaitResult",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "ledger_entry": {
      "$ref": "#/$defs/LedgerEntry"
    },
    "status": {
      "$ref": "#/$defs/IntentStatus"
    },
    "wait": {
      "anyOf": [
        {
          "$ref": "#/$defs/WaitResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "ledger_entry",
    "status"
  ],
  "title": "InsertStep23Output",
  "type": "object"
}
