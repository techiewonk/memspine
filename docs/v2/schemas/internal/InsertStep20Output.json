{
  "$defs": {
    "AssertionKey": {
      "additionalProperties": true,
      "description": "What an assertion is about: ``(src, rel, dst, kind)`` under the envelope's owner scope (M-17).\n\n``key_v`` versions the normalisation rules. The scope lives on the envelope, not here.",
      "properties": {
        "dst": {
          "default": "",
          "title": "Dst",
          "type": "string"
        },
        "key_v": {
          "default": 1,
          "minimum": 1,
          "title": "Key V",
          "type": "integer"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "rel": {
          "minLength": 1,
          "title": "Rel",
          "type": "string"
        },
        "src": {
          "minLength": 1,
          "title": "Src",
          "type": "string"
        }
      },
      "required": [
        "src",
        "rel",
        "kind"
      ],
      "title": "AssertionKey",
      "type": "object"
    },
    "AttachDecision": {
      "additionalProperties": true,
      "description": "``new | support_of(<assertion id>)`` (step 20).",
      "properties": {
        "assertion_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assertion Id"
        },
        "mode": {
          "enum": [
            "new",
            "support_of"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "AttachDecision",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "attach": {
      "$ref": "#/$defs/AttachDecision"
    },
    "key": {
      "$ref": "#/$defs/AssertionKey"
    },
    "occurrence_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurrence Id"
    }
  },
  "required": [
    "key",
    "attach"
  ],
  "title": "InsertStep20Output",
  "type": "object"
}
