{
  "additionalProperties": true,
  "description": "An offset that the watermark passed without a successful result (ER-09).",
  "properties": {
    "attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "offset": {
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "reason": {
      "enum": [
        "raised",
        "malformed",
        "valid_empty",
        "truncated",
        "size_skip",
        "partial_commit",
        "invented_alias",
        "budget_exhausted"
      ],
      "title": "Reason",
      "type": "string"
    },
    "waived": {
      "default": false,
      "title": "Waived",
      "type": "boolean"
    }
  },
  "required": [
    "offset",
    "reason"
  ],
  "title": "Hole",
  "type": "object"
}
