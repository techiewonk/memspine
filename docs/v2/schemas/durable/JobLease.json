{
  "$defs": {
    "OwnerScope": {
      "additionalProperties": true,
      "description": "Memory scope: tenant plus memory owner (S3-1).\n\nThe owner is a user or a shared group; every agent and session serving that owner sees the same\nentities. The session is *not* part of the scope: it is recorded as :class:`Provenance` only.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_kind": {
          "default": "user",
          "enum": [
            "user",
            "group"
          ],
          "title": "Owner Kind",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "owner"
      ],
      "title": "OwnerScope",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "A claim on a job or namespace. ``epoch`` strictly increases per (scope, job) with each claim.",
  "properties": {
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
    "epoch": {
      "minimum": 1,
      "title": "Epoch",
      "type": "integer"
    },
    "heartbeat_at": {
      "format": "date-time",
      "title": "Heartbeat At",
      "type": "string"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "lease_until": {
      "format": "date-time",
      "title": "Lease Until",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/OwnerScope"
    }
  },
  "required": [
    "scope",
    "job_id",
    "owner",
    "epoch",
    "acquired_at",
    "heartbeat_at",
    "lease_until"
  ],
  "title": "JobLease",
  "type": "object",
