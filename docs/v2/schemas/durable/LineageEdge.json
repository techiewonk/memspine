{
  "$defs": {
    "Fingerprint": {
      "additionalProperties": true,
      "description": "Derivation fingerprint (P-12): what produced a derived item, for staleness and re-derivation.",
      "properties": {
        "decoding": {
          "title": "Decoding",
          "type": "string"
        },
        "input_blocks": {
          "title": "Input Blocks",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "quant": {
          "title": "Quant",
          "type": "string"
        },
        "runtime_libs": {
          "title": "Runtime Libs",
          "type": "string"
        },
        "schema_v": {
          "title": "Schema V",
          "type": "string"
        }
      },
      "required": [
        "prompt_hash",
        "schema_v",
        "model_id",
        "quant",
        "decoding",
        "input_blocks",
        "runtime_libs"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "Span": {
      "additionalProperties": true,
      "description": "Character range inside one turn, plus the verbatim excerpt when kept.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "One edge of the lineage DAG. A derived record inherits families and trust bounds through these.",
  "properties": {
    "child": {
      "minLength": 1,
      "title": "Child",
      "type": "string"
    },
    "derivation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Fingerprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent": {
      "minLength": 1,
      "title": "Parent",
      "type": "string"
    },
    "parent_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Version"
    },
    "role": {
      "enum": [
        "support",
        "binding",
        "context",
        "version_of",
        "supersedes",
        "merge_member",
        "member",
        "cites"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Family"
    },
    "span": {
      "anyOf": [
        {
          "$ref": "#/$defs/Span"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "child",
    "parent",
    "role"
  ],
  "title": "LineageEdge",
  "type": "object",
  "x-kind": "lineage_edge",
  "x-schema-version": 1
}
