{
  "$defs": {
    "OwnerScope": {
      "additionalProperties": true,
      "description": "Memory scope: tenant plus memory owner (S3-1).\n\nThe owner is a user or a shared group; every agent and session serving that owner sees the same\nentities. The session is *not* part of the scope: it is recorded as :class:`Provenance` only.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_kind": {
          "default": "user",
          "enum": [
            "user",
            "group"
          ],
          "title": "Owner Kind",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "owner"
      ],
      "title": "OwnerScope",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The retained-history boundary (ER-27): what a rebuild can still do under the event-log mode.\n\nUnder rolling retention, lineage and tombstones are kept, and the store reports a limited rebuild.",
  "properties": {
    "boundary_seq": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Boundary Seq"
    },
    "boundary_ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Boundary Ts"
    },
    "lineage_kept": {
      "default": true,
      "title": "Lineage Kept",
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "full",
        "rolling",
        "ephemeral"
      ],
      "title": "Mode",
      "type": "string"
    },
    "rebuild": {
      "enum": [
        "full",
        "limited",
        "unavailable"
      ],
      "title": "Rebuild",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/OwnerScope"
    },
    "tombstones_kept": {
      "default": true,
      "title": "Tombstones Kept",
      "type": "boolean"
    }
  },
  "required": [
    "scope",
    "mode",
    "rebuild"
  ],
  "title": "RetentionBoundary",
  "type": "object",
  "x-kind": "retention_boundary",
  "x-schema-version": 1
}
