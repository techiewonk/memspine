{
  "$defs": {
    "OwnerScope": {
      "additionalProperties": true,
      "description": "Memory scope: tenant plus memory owner (S3-1).\n\nThe owner is a user or a shared group; every agent and session serving that owner sees the same\nentities. The session is *not* part of the scope: it is recorded as :class:`Provenance` only.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_kind": {
          "default": "user",
          "enum": [
            "user",
            "group"
          ],
          "title": "Owner Kind",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "owner"
      ],
      "title": "OwnerScope",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "The policy promise frozen in the same transaction as raw acceptance.",
  "properties": {
    "activated_at": {
      "format": "date-time",
      "title": "Activated At",
      "type": "string"
    },
    "historical": {
      "const": false,
      "default": false,
      "title": "Historical",
      "type": "boolean"
    },
    "intent_id": {
      "minLength": 1,
      "title": "Intent Id",
      "type": "string"
    },
    "namespace": {
      "minLength": 1,
      "title": "Namespace",
      "type": "string"
    },
    "policy_revision": {
      "minLength": 1,
      "title": "Policy Revision",
      "type": "string"
    },
    "registry_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registry Digest"
    },
    "required_layers": {
      "items": {
        "enum": [
          "raw_store",
          "vector",
          "lexical",
          "annotations",
          "facts",
          "graph_mentions",
          "summaries"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Layers",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/OwnerScope"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_record_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Record Ids",
      "type": "array"
    },
    "source_version": {
      "minimum": 1,
      "title": "Source Version",
      "type": "integer"
    },
    "source_write_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Write Ids",
      "type": "array"
    }
  },
  "required": [
    "intent_id",
    "namespace",
    "scope",
    "source_id",
    "source_version",
    "source_write_ids",
    "required_layers",
    "policy_revision",
    "activated_at"
  ],
  "title": "RequiredDerivation",
  "type": "object",
  "x-kind": "required_derivation",
  "x-schema-version": 1
}
