{
  "$defs": {
    "Hole": {
      "additionalProperties": true,
      "description": "An offset that the watermark passed without a successful result (ER-09).",
      "properties": {
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "raised",
            "malformed",
            "valid_empty",
            "truncated",
            "size_skip",
            "partial_commit",
            "invented_alias",
            "budget_exhausted"
          ],
          "title": "Reason",
          "type": "string"
        },
        "waived": {
          "default": false,
          "title": "Waived",
          "type": "boolean"
        }
      },
      "required": [
        "offset",
        "reason"
      ],
      "title": "Hole",
      "type": "object"
    },
    "OwnerScope": {
      "additionalProperties": true,
      "description": "Memory scope: tenant plus memory owner (S3-1).\n\nThe owner is a user or a shared group; every agent and session serving that owner sees the same\nentities. The session is *not* part of the scope: it is recorded as :class:`Provenance` only.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_kind": {
          "default": "user",
          "enum": [
            "user",
            "group"
          ],
          "title": "Owner Kind",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "owner"
      ],
      "title": "OwnerScope",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Contiguous watermark plus an explicit list of holes.\n\nEvery offset up to and including ``watermark`` was handled; the ``holes`` among them were not\nsuccessfully derived and stay listed until filled (the hole is removed) or waived.",
  "properties": {
    "holes": {
      "items": {
        "$ref": "#/$defs/Hole"
      },
      "title": "Holes",
      "type": "array"
    },
    "job_kind": {
      "minLength": 1,
      "title": "Job Kind",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/OwnerScope"
    },
    "target_offset": {
      "anyOf": [
        {
          "minimum": -1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Offset"
    },
    "watermark": {
      "minimum": -1,
      "title": "Watermark",
      "type": "integer"
    }
  },
  "required": [
    "scope",
    "job_kind",
    "watermark"
  ],
  "title": "Progress",
  "type": "object",
  "x-kind": "progress",
  "x-schema-version": 1
}
