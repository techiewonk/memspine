{
  "$defs": {
    "Readiness": {
      "additionalProperties": true,
      "description": "State of each capability for a write. A capability that is not configured is ``unavailable``,\nnever ``pending`` (S7).",
      "properties": {
        "facts": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Facts",
          "type": "string"
        },
        "graph": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Graph",
          "type": "string"
        },
        "profile": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Profile",
          "type": "string"
        },
        "raw_search": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Raw Search",
          "type": "string"
        },
        "summaries": {
          "enum": [
            "pending",
            "ready",
            "unavailable",
            "failed"
          ],
          "title": "Summaries",
          "type": "string"
        }
      },
      "required": [
        "raw_search",
        "facts",
        "graph",
        "summaries",
        "profile"
      ],
      "title": "Readiness",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Durable acceptance of a write (ER-06).\n\n``durability`` is ``durable``, or ``memory`` in ephemeral mode (the weaker guarantee). A retry, as\nidentified by the S3-3 write id, returns the original receipt.",
  "properties": {
    "accepted_seq": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accepted Seq"
    },
    "durability": {
      "enum": [
        "durable",
        "memory"
      ],
      "title": "Durability",
      "type": "string"
    },
    "event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Event Ids",
      "type": "array"
    },
    "intent_id": {
      "title": "Intent Id",
      "type": "string"
    },
    "quarantined": {
      "items": {
        "type": "integer"
      },
      "title": "Quarantined",
      "type": "array"
    },
    "readiness": {
      "$ref": "#/$defs/Readiness"
    },
    "record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Record Ids",
      "type": "array"
    },
    "retried": {
      "items": {
        "type": "integer"
      },
      "title": "Retried",
      "type": "array"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "minimum": 1,
      "title": "Source Version",
      "type": "integer"
    }
  },
  "required": [
    "durability",
    "event_ids",
    "record_ids",
    "intent_id",
    "source_id",
    "source_version",
    "readiness"
  ],
  "title": "Receipt",
  "type": "object",
  "x-semver": "1.0.0"
}
