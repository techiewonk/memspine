{
  "$defs": {
    "OwnerScope": {
      "additionalProperties": true,
      "description": "Memory scope: tenant plus memory owner (S3-1).\n\nThe owner is a user or a shared group; every agent and session serving that owner sees the same\nentities. The session is *not* part of the scope: it is recorded as :class:`Provenance` only.",
      "properties": {
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "owner_kind": {
          "default": "user",
          "enum": [
            "user",
            "group"
          ],
          "title": "Owner Kind",
          "type": "string"
        },
        "tenant": {
          "minLength": 1,
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "tenant",
        "owner"
      ],
      "title": "OwnerScope",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "A read. A multi-party read must carry a viewer, bound to the authenticated principal (ER-29).\n\n``principal`` is set by the handle from authentication, never by the caller's payload; ``viewer`` must\nbe that principal. A multi-party read without a viewer is rejected.",
  "properties": {
    "as_of_known": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of Known"
    },
    "as_of_valid": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of Valid"
    },
    "budget_tokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Tokens"
    },
    "depth": {
      "anyOf": [
        {
          "enum": [
            "fast",
            "standard",
            "deep"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Depth"
    },
    "lang": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lang"
    },
    "multi_party": {
      "default": false,
      "title": "Multi Party",
      "type": "boolean"
    },
    "principal": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Principal"
    },
    "query": {
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "reference_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Time"
    },
    "scope": {
      "$ref": "#/$defs/OwnerScope"
    },
    "viewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Viewer"
    }
  },
  "required": [
    "query",
    "scope"
  ],
  "title": "ReadRequest",
  "type": "object",
  "x-semver": "1.0.0"
}
