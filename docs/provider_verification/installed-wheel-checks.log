Exact installed-wheel smoke program (`%TEMP%\memspine-wheel-smoke-run\wheel_smoke.py`):
```python
import asyncio
import pathlib
import sys

import memspine
from memspine import Engine

async def main():
    origin = pathlib.Path(memspine.__file__).resolve()
    venv = pathlib.Path(sys.prefix).resolve()
    assert origin.is_relative_to(venv), (origin, venv)
    engine = Engine(
        template='core', dotenv_path=None,
        storage={'provider': 'sqlite', 'settings': {'path': ':memory:', 'busy_timeout_s': 5.0}},
        embedding={'provider': 'hash', 'settings': {}},
    )
    await engine.start()
    try:
        written = await engine.write(
            'wheel smoke: the cobalt fox crosses the bridge', namespace='wheel-smoke'
        )
        matches = await engine.search('cobalt fox bridge', namespace='wheel-smoke', top_k=3)
        assert matches and any(record.record_id == written.record_id for record, _ in matches)
    finally:
        await engine.stop()

asyncio.run(main())
```
