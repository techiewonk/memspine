# Line endings (ENV-4): LF in the repository and in the working tree, so a Windows
# checkout does not show every file as modified. Windows-only scripts keep CRLF.
* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never normalise or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.whl binary
*.parquet binary
*.npy binary
*.npz binary
*.pt binary
*.safetensors binary
*.onnx binary
*.sqlite binary
*.sqlite3 binary
*.db binary
*.lance binary
*.woff binary
*.woff2 binary
