{
  "read": {
    "record_access": false,
    "scoring": {
      "recency_weight": 0.0,
      "importance_weight": 0.0,
      "utility_weight": 0.0
    },
    "resolve_relative_dates": true,
    "order_by_time_for_ordering": true,
    "assembly": {
      "relative_floor": 0.3
    },
    "replay_window_before": 2,
    "replay_window_after": 4,
    "relative_dates_anchored": true,
    "temporal_leg_mentions": true,
    "candidate_pool": 2,
    "list_mode": true,
    "perspective_mode": "subject_weight",
    "pool_protect_per_leg": 3,
    "graph_leg": true,
    "graph_leg_k": 10,
    "graph_depth": 2,
    "graph_node_search": true,
    "entity_summaries": true,
    "gate": true,
    "deep": true,
    "obligations": true,
    "trust_rendering": true
  },
  "storage": {
    "records": {
      "provider": "sqlite",
      "settings": {
        "path": "tempdir"
      }
    }
  },
  "memories": {
    "episodic": {
      "policies": {
        "perspective": "heuristic"
      }
    },
    "semantic": {
      "enabled": true,
      "policies": {
        "extract_graph": {
          "granularity": "session",
          "resolve": "rules"
        }
      }
    },
    "associative": {
      "enabled": true,
      "policies": {
        "entity_nodes": true,
        "entity_summaries": true
      }
    }
  },
  "graph": {
    "entity_embeddings": true
  },
  "model": {
    "embedding": {
      "provider": "st",
      "settings": {
        "model": "Qwen/Qwen3-Embedding-0.6B",
        "dim": 1024,
        "device": "cuda",
        "dtype": "bfloat16",
        "query_instruction": "Instruct: Given a question about a user's past conversations, retrieve memories that answer it\nQuery: "
      }
    },
    "llm": {
      "extract_edges": {
        "settings": {
          "model": "qwen3.5:9b",
          "no_think": true,
          "base_url": "http://127.0.0.1:11434"
        },
        "timeout_s": 180.0,
        "provider": "ollama",
        "structured": {
          "retry_on_error": true
        }
      },
      "summarize_entity": {
        "settings": {
          "model": "qwen3.5:9b",
          "no_think": true,
          "base_url": "http://127.0.0.1:11434"
        },
        "timeout_s": 180.0,
        "provider": "ollama",
        "structured": {
          "retry_on_error": true
        }
      },
      "sufficiency": {
        "provider": "ollama",
        "timeout_s": 180.0,
        "settings": {
          "model": "qwen3.5:9b",
          "base_url": "http://127.0.0.1:11434",
          "no_think": true
        }
      }
    },
    "rerank": {
      "chain": [
        {
          "provider": "jina",
          "settings": {
            "model": "jinaai/jina-reranker-v3.5",
            "device": "cuda"
          }
        }
      ],
      "keep": 10,
      "floor": "skip"
    }
  }
}
