{
  "read": {
    "record_access": false,
    "scoring": {
      "recency_weight": 0.0,
      "importance_weight": 0.0,
      "utility_weight": 0.0
    },
    "resolve_relative_dates": true,
    "order_by_time_for_ordering": true,
    "assembly": {
      "relative_floor": 0.3
    },
    "replay_window_before": 2,
    "replay_window_after": 4,
    "relative_dates_anchored": true,
    "temporal_leg_mentions": true,
    "candidate_pool": 2,
    "list_mode": true,
    "perspective_mode": "subject_weight",
    "pool_protect_per_leg": 3,
    "view_tag_leg": true,
    "raw_turn_floor": true
  },
  "storage": {
    "records": {
      "provider": "sqlite",
      "settings": {
        "path": "tempdir"
      }
    }
  },
  "memories": {
    "episodic": {
      "policies": {
        "perspective": "heuristic",
        "consolidation": {
          "mine_facts": true,
          "miner": "llm",
          "mine_multiview": true,
          "list_cards": true,
          "mining_cache": true
        }
      }
    },
    "semantic": {
      "enabled": true
    }
  },
  "model": {
    "embedding": {
      "provider": "st",
      "settings": {
        "model": "Qwen/Qwen3-Embedding-0.6B",
        "dim": 1024,
        "device": "cuda",
        "dtype": "bfloat16",
        "query_instruction": "Instruct: Given a question about a user's past conversations, retrieve memories that answer it\nQuery: "
      }
    },
    "llm": {
      "extract": {
        "settings": {
          "model": "qwen3.5:9b",
          "no_think": true,
          "base_url": "http://127.0.0.1:11434"
        },
        "timeout_s": 180.0,
        "provider": "ollama",
        "structured": {
          "retry_on_error": true
        }
      }
    },
    "rerank": {
      "chain": [
        {
          "provider": "jina",
          "settings": {
            "model": "jinaai/jina-reranker-v3.5",
            "device": "cuda"
          }
        }
      ],
      "keep": 10,
      "floor": "skip"
    }
  }
}
