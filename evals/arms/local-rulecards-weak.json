{
  "read": {
    "record_access": false,
    "scoring": {
      "recency_weight": 0.0,
      "importance_weight": 0.0,
      "utility_weight": 0.0
    },
    "resolve_relative_dates": true,
    "order_by_time_for_ordering": true,
    "assembly": {
      "relative_floor": 0.3
    },
    "cards": "header",
    "raw_turn_floor": true,
    "verbatim_raw_only": true,
    "cards_when_weak": true
  },
  "storage": {
    "records": {
      "provider": "sqlite",
      "settings": {
        "path": "tempdir"
      }
    }
  },
  "memories": {
    "episodic": {
      "enabled": true,
      "policies": {
        "consolidation": {
          "mine_facts": true,
          "miner": "rules"
        }
      }
    },
    "semantic": {
      "enabled": true
    }
  },
  "model": {
    "embedding": {
      "provider": "onnx",
      "settings": {
        "model": "BAAI/bge-small-en-v1.5"
      }
    }
  }
}
