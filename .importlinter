; Import-boundary contracts for memspine (restructure package P0-04).
;
; Source of truth for BOTH the import-linter CLI (`lint-imports`, once it is a dev
; dependency) and tests/unit/test_import_contracts.py (an AST checker that reads this
; file with configparser, because import-linter is not installed in every env).
; Keep the contract syntax inside the subset the test understands:
;   type = layers     with `layers` (one layer per line; `a | b` = independent siblings,
;                     `a : b` = siblings that may import each other)
;   type = forbidden  with `source_modules`, `forbidden_modules` (one dotted name per line)
; Only direct imports are checked by the test (also function-level and TYPE_CHECKING
; imports, which import-linter counts too).
;
; Target layering: docs/v2/RESTRUCTURE.md section 1 and docs/v2/ARCHITECTURE.md section 8.
;   api -> runtime (the DI container) -> (ingest, derive, read, compose)
;       -> (store, models, trust, prompts, memory) -> schemas
; config, observability and errors are cross-cutting: they sit outside the layers and are
; policed by the forbidden contracts only.
; CI never feeds this file to lint-imports as is, because it names packages that do not
; exist yet. scripts/ci_importlinter.py writes a filtered copy that drops every module that
; does not exist (and any contract left without sources or targets), so a new package is
; enforced from the commit it appears in. The AST test reads this full file.
; Today's v1 packages (core, services, memories, workers, protocols, clients) get their
; own transitional contracts at the bottom; delete those as the packages are moved.
;
; External packages (RM-113): include_external_packages = True, so a forbidden contract may
; name a third-party top-level package (redis, httpx, boto3, ...). Name ROOT packages only.
; `ignore_imports` in a contract is a PERMANENT, reviewed exemption (both checkers honour it,
; `*` = one module segment, `**` = one or more). Temporary violations never go here: they live
; in tests/unit/baselines/import_contracts.txt, which must only shrink
; (docs/CLIENT_ADAPTER_FACTORY_STANDARD.md section 4).

[importlinter]
root_package = memspine
include_external_packages = True

; ---------------------------------------------------------------------------------------
; Target contracts
; ---------------------------------------------------------------------------------------

[importlinter:contract:target-layers]
name = Target layers: api above runtime above the pipelines above the foundations above schemas
type = layers
layers =
    memspine.api
    memspine.runtime
    memspine.ingest : memspine.derive : memspine.read : memspine.compose
    memspine.store : memspine.models : memspine.trust : memspine.prompts : memspine.memory
    memspine.schemas

[importlinter:contract:schemas-leaf]
name = schemas is a leaf (imports only errors)
type = forbidden
source_modules =
    memspine.schemas
forbidden_modules =
    memspine.api
    memspine.ingest
    memspine.derive
    memspine.read
    memspine.compose
    memspine.store
    memspine.models
    memspine.trust
    memspine.memory
    memspine.runtime
    memspine.prompts
    memspine.config
    memspine.observability
    memspine.api.engine
allow_indirect_imports = True

[importlinter:contract:store-below-pipelines]
name = store never imports read, derive, ingest, compose, api
type = forbidden
source_modules =
    memspine.store
forbidden_modules =
    memspine.read
    memspine.derive
    memspine.ingest
    memspine.compose
    memspine.api
allow_indirect_imports = True

[importlinter:contract:read-not-derive]
name = read never imports derive
type = forbidden
source_modules =
    memspine.read
forbidden_modules =
    memspine.derive
allow_indirect_imports = True

[importlinter:contract:foundations-not-above]
name = models, trust, prompts, memory never import the pipelines or api
type = forbidden
source_modules =
    memspine.models
    memspine.trust
    memspine.prompts
    memspine.memory
forbidden_modules =
    memspine.api
    memspine.ingest
    memspine.derive
    memspine.read
    memspine.compose
allow_indirect_imports = True

[importlinter:contract:runtime-not-api]
name = runtime never imports api
type = forbidden
source_modules =
    memspine.runtime
forbidden_modules =
    memspine.api
allow_indirect_imports = True

; "No module imports engine except api and tests." The facade is `memspine.api.engine`. The root
; package (memspine/__init__.py, which re-exports Engine) and memspine.api are the only allowed importers; the sources below
; are therefore every other top-level package (target and v1).
[importlinter:contract:engine-only-from-api]
name = Only memspine.api (and the root package) import the engine facade
type = forbidden
source_modules =
    memspine.cli
    memspine.clients
    memspine.config
    memspine.core
    memspine.memories
    memspine.observability
    memspine.prompts
    memspine.services
    memspine.workers
    memspine.schemas
    memspine.store
    memspine.models
    memspine.trust
    memspine.memory
    memspine.runtime
    memspine.ingest
    memspine.derive
    memspine.read
    memspine.compose
forbidden_modules =
    memspine.api.engine
allow_indirect_imports = True

; ---------------------------------------------------------------------------------------
; RM-113 client / adapter / factory isolation (docs/CLIENT_ADAPTER_FACTORY_STANDARD.md)
; Port = services/<slot>/base.py, connector = clients/<tech>, adapter = services/<slot>/<tech>.py,
; factory = providers/builtin/<slot>.py. clients-isolated replaces the old v1-clients-low.
; ---------------------------------------------------------------------------------------

[importlinter:contract:clients-isolated]
name = clients import only stdlib, drivers, memspine.exceptions and memspine.clients
type = forbidden
source_modules =
    memspine.clients
forbidden_modules =
    memspine.api
    memspine.cli
    memspine.compose
    memspine.config
    memspine.core
    memspine.derive
    memspine.economy
    memspine.ingest
    memspine.memories
    memspine.memory
    memspine.models
    memspine.observability
    memspine.ops
    memspine.plugins
    memspine.prompts
    memspine.providers
    memspine.read
    memspine.runtime
    memspine.schemas
    memspine.scope
    memspine.semantics
    memspine.services
    memspine.store
    memspine.trust
    memspine.workers
allow_indirect_imports = True

; Alembic env.py and revision scripts are migration tooling that runs on a connection of its
; own; they are exempt (permanent ignore below).
[importlinter:contract:services-no-transport]
name = services and models (ports, adapters) never import transport or driver packages
type = forbidden
source_modules =
    memspine.services
    memspine.models
forbidden_modules =
    psycopg
    aiosqlite
    sqlcipher3
    pysqlcipher3
    redis
    cashews
    httpx
    aiohttp
    boto3
    botocore
    aioboto3
    pymongo
    motor
    neo4j
    litellm
    huggingface_hub
# Alembic env/versions no longer import transport packages (RM-113: migrations run over a
# connector-lent connection), so no ignore_imports exemption is needed.
allow_indirect_imports = True

[importlinter:contract:services-not-composition]
name = services and models never import providers, runtime or api
type = forbidden
source_modules =
    memspine.services
    memspine.models
forbidden_modules =
    memspine.providers
    memspine.runtime
    memspine.api
allow_indirect_imports = True

[importlinter:contract:consumers-never-see-clients]
name = engine, memories, memory, pipelines, store and trust never import clients or provider builders
type = forbidden
source_modules =
    memspine.api.engine
    memspine.memories
    memspine.memory
    memspine.derive
    memspine.read
    memspine.ingest
    memspine.compose
    memspine.store
    memspine.trust
forbidden_modules =
    memspine.clients
    memspine.providers.builtin
allow_indirect_imports = True

[importlinter:contract:providers-composition-only]
name = providers (factories) never import consumers
type = forbidden
source_modules =
    memspine.providers
forbidden_modules =
    memspine.api
    memspine.memories
    memspine.derive
    memspine.read
    memspine.ingest
    memspine.compose
allow_indirect_imports = True

; ---------------------------------------------------------------------------------------
; Transitional contracts for the v1 layout (true today; delete a contract when the
; packages it names have moved). They stop new upward imports while the moves are under way.
; ---------------------------------------------------------------------------------------

[importlinter:contract:v1-core-leaf]
name = v1 core imports no service, memory, worker, client, protocol or engine
type = forbidden
source_modules =
    memspine.core
forbidden_modules =
    memspine.api.engine
    memspine.api.rest
    memspine.api.mcp
    memspine.api.tools
    memspine.workers
    memspine.memories
    memspine.services
    memspine.clients
    memspine.cli
allow_indirect_imports = True

[importlinter:contract:v1-services-below-memories]
name = v1 services never import memories, workers, protocols, engine
type = forbidden
source_modules =
    memspine.services
forbidden_modules =
    memspine.api.engine
    memspine.api.rest
    memspine.api.mcp
    memspine.api.tools
    memspine.workers
    memspine.memories
    memspine.cli
allow_indirect_imports = True

[importlinter:contract:v1-memories-below-workers]
name = v1 memories never import workers, protocols, engine
type = forbidden
source_modules =
    memspine.memories
forbidden_modules =
    memspine.api.engine
    memspine.api.rest
    memspine.api.mcp
    memspine.api.tools
    memspine.workers
    memspine.cli
allow_indirect_imports = True

[importlinter:contract:v1-workers-below-engine]
name = v1 workers never import protocols, engine
type = forbidden
source_modules =
    memspine.workers
forbidden_modules =
    memspine.api.engine
    memspine.api.rest
    memspine.api.mcp
    memspine.api.tools
    memspine.cli
allow_indirect_imports = True

[importlinter:contract:v1-support-packages]
name = v1 config, prompts, observability import no service, memory, worker, protocol or engine
type = forbidden
source_modules =
    memspine.config
    memspine.prompts
    memspine.observability
forbidden_modules =
    memspine.api.engine
    memspine.api.rest
    memspine.api.mcp
    memspine.api.tools
    memspine.workers
    memspine.memories
    memspine.services
    memspine.clients
    memspine.cli
allow_indirect_imports = True

[importlinter:contract:v1-engine-not-protocols]
name = v1 engine never imports protocols or cli
type = forbidden
source_modules =
    memspine.api.engine
forbidden_modules =
    memspine.api.rest
    memspine.api.mcp
    memspine.api.tools
    memspine.cli
allow_indirect_imports = True
